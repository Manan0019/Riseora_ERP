PORT=5000
NODE_ENV=development
CLIENT_ORIGIN=http://localhost:5173

# Replace this with a long random value.
SESSION_SECRET=replace-with-a-long-random-secret

# Administrator used when a fresh database is created.
INITIAL_ADMIN_USERNAME=ram
INITIAL_ADMIN_FULL_NAME=Ram

# IMPORTANT:
# Before running `npm run prepare:production -- --confirm`,
# set a strong real password here in your actual server/.env.
INITIAL_ADMIN_PASSWORD=replace-with-a-strong-password

# Optional database path override.
# RISEORA_DB_PATH=C:\\Riseora ERP\\data\\riseora_erp.db

# -----------------------------
# Forgot Password / OTP email
# -----------------------------
#
# The OTP recipient is NOT configured here.
# Riseora sends the OTP to the Email saved in Company Master.
#
# These settings are only for the OUTGOING SMTP sender.
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=riseoraherbals@gmail.com
SMTP_PASS=PUT_GOOGLE_APP_PASSWORD_HERE
SMTP_FROM=Riseora Herbals <riseoraherbals@gmail.com>

# Password-reset security.
PASSWORD_RESET_OTP_MINUTES=10
PASSWORD_RESET_RESEND_SECONDS=60
PASSWORD_RESET_MAX_ATTEMPTS=5